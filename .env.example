# Copy this file to .env and replace each placeholder with a strong,
# independently generated value. Never commit the real .env file.
APP_ENV=development
LOG_LEVEL=INFO
VIEWER_API_KEY=replace-with-a-strong-viewer-key
ANALYST_API_KEY=replace-with-a-strong-analyst-key
ADMIN_API_KEY=replace-with-a-strong-admin-key

